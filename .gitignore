# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Build outputs. Patterns are anchored to the repo root so they cannot match a
# source directory of the same name, which would silently ignore new code.
# src/human2robot/data/ is a real package and must stay trackable.
/build/
/dist/
*.egg-info/

# C++ build tree; cpp sources stay under version control
/cpp/build/
/target/

# The Rust inference server (Phase 10) is NOT unstarted: rust/inference_server/
# holds 121 lines of working axum + ONNX Runtime code in src/main.rs.
#
# It is currently untracked by anything. rust/inference_server/.git exists but is
# an accidental `git init` with zero commits, zero refs and zero objects, so the
# code has no version control at all and lives only on this disk. Folding it
# into this repository requires removing that vestigial .git directory first,
# which is a scope decision that is still open.
#
# Until that is decided it is ignored here so the empty nested repository does
# not appear as a broken gitlink. Do not read this as a statement that the work
# does not exist.
/rust/

# Experiment and data outputs are never committed
/data/
/results/

# Third-party reference repos
/references/

# Per-run training logs
/logs/

# Local tooling state (.agents/skills is tracked on purpose)
/.freebuff/
.idea/
.vscode/

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# MuJoCo runtime artifact
MUJOCO_LOG.TXT
