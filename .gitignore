# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Build outputs. Patterns are anchored to the repo root so they cannot match a
# source directory of the same name, which would silently ignore new code.
# src/human2robot/data/ is a real package and must stay trackable.
/build/
/dist/
*.egg-info/

# C++ build tree; cpp sources stay under version control
/cpp/build/

# Cargo build trees. The pattern is anchored at the repository root and then
# repeated for the Rust workspace, because an unanchored `target/` would also
# match any directory of that name anywhere in the tree, including inside data
# and reference checkouts.
/target/
/rust/**/target/

# Experiment and data outputs are never committed
/data/
/results/

# Third-party reference repos
/references/

# Per-run training logs
/logs/

# Local tooling state (.agents/skills is tracked on purpose)
/.freebuff/
.idea/
.vscode/

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini

# MuJoCo runtime artifact
MUJOCO_LOG.TXT
